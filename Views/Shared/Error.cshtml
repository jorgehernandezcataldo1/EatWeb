@model ErrorViewModel
@{
    ViewData["Title"] = "Ocurrió un problema";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-body text-center p-4">
                <div class="display-5 mb-3">⚠️</div>
                <h1 class="h3">No pudimos completar la operación</h1>
                <p class="text-muted">
                    Intenta nuevamente. Si el problema continúa, vuelve al inicio o avisa al administrador del local.
                </p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-3">
                        Código de referencia:
                        <code>@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>
