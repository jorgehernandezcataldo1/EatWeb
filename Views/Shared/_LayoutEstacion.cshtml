@{
    var usuarioNombre = User.Identity?.Name ?? "Operador";
    var estacion = User.IsInRole(Roles.Bar) ? "Bar" : "Cocina";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Comidita</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="station-body">
<header class="station-topbar">
    <div class="station-topbar-inner">
        <a class="station-brand" asp-controller="EstacionTrabajo" asp-action="Index">Comidita</a>

        <div class="station-title-block">
            <span class="station-divider d-none d-md-block"></span>
            <div>
                <div class="station-name">@estacion</div>
                <div class="station-active-line">
                    <span class="station-active-dot"></span>
                    <span>Estación activa</span>
                    <small class="d-none d-lg-inline">· @usuarioNombre</small>
                </div>
            </div>
        </div>

        <div class="station-top-actions">
            <div class="station-clock d-none d-sm-block">
                <strong id="stationClock">--:--</strong>
                <small id="stationDate"></small>
            </div>

            <button type="button" id="stationSoundToggle" class="station-sound-button">
                🔊 <span>Sonido activado</span>
            </button>

            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="station-exit-button" title="Cerrar sesión" aria-label="Cerrar sesión">⎋</button>
            </form>
        </div>
    </div>
</header>

@if (TempData["Error"] != null)
{
    <div class="station-flash alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Ok"] != null)
{
    <div class="station-flash alert alert-success alert-dismissible fade show">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<main class="station-main">
    @RenderBody()
</main>

@Html.AntiForgeryToken()
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
(() => {
    const clock = document.getElementById('stationClock');
    const date = document.getElementById('stationDate');

    function tick() {
        const now = new Date();
        if (clock) {
            clock.textContent = now.toLocaleTimeString('es-CL', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: false
            });
        }
        if (date) {
            date.textContent = now.toLocaleDateString('es-CL', {
                weekday: 'short',
                day: '2-digit',
                month: 'short'
            });
        }
    }

    tick();
    setInterval(tick, 30000);
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>