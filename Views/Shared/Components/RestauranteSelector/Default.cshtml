@model EatWeb.ViewComponents.RestauranteSelectorViewModel
@if (Model.Restaurantes.Count > 0)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
            @(Model.RestauranteActualNombre ?? "Seleccionar restaurante")
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            @foreach (var restaurante in Model.Restaurantes)
            {
                <li>
                    <a class="dropdown-item @(restaurante.Id == Model.RestauranteActualId ? "active" : "")"
                       asp-controller="Admin" asp-action="SeleccionarRestaurante" asp-route-id="@restaurante.Id">
                        @restaurante.Nombre
                    </a>
                </li>
            }
        </ul>
    </li>
}
