@model SuperAdminIndexViewModel
@using EatWeb.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Clientes y planes · EatWeb";
    var planes = (List<PlanComercial>)ViewBag.Planes;
    var funciones = (List<Funcionalidad>)ViewBag.Funcionalidades;
    var suscripciones = (List<SuscripcionComercial>)ViewBag.Suscripciones;
    var usuarios = (Dictionary<int,int>)ViewBag.UsuariosPorRestaurante;
    var planFunciones = (HashSet<string>)ViewBag.PlanFuncionalidades;
}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div><h1 class="h3 mb-1">Clientes comerciales</h1><p class="text-muted mb-0">Panel exclusivo del propietario · Cadenas y restaurantes</p></div>
        <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary">Salir</button></form>
    </div>
    @if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
    <div class="row g-4">
        <div class="col-12 col-lg-6"><section class="card h-100">
            <div class="card-header"><h2 class="h5 mb-0">Cadenas (@Model.Cadenas.Count)</h2></div>
            <div class="card-body">
                <form asp-action="GuardarCadena" method="post" class="d-flex gap-2 mb-3">
                    <input name="nombre" class="form-control" maxlength="120" required placeholder="Nombre de cadena" />
                    <button class="btn btn-primary">Crear</button>
                </form>
                @foreach(var c in Model.Cadenas) {
                    <div class="border rounded p-2 mb-2">
                        <form asp-action="GuardarCadena" method="post" class="row g-2 align-items-center">
                            <input type="hidden" name="id" value="@c.Id" />
                            <div class="col-5"><input name="nombre" class="form-control form-control-sm" value="@c.Nombre" required maxlength="120" /></div>
                            <div class="col-3"><span class="small">@c.Restaurantes locales</span></div>
                            <div class="col-2"><select name="activo" class="form-select form-select-sm">
                                <option value="true" selected="@c.Activo">Activa</option><option value="false" selected="@(!c.Activo)">Inactiva</option>
                            </select></div>
                            <div class="col-2"><button class="btn btn-sm btn-outline-primary">Guardar</button></div>
                        </form>
                        <div class="small mt-1">@(suscripciones.FirstOrDefault(s=>s.CadenaId==c.Id) is { } sub ? planes.FirstOrDefault(p=>p.Id==sub.PlanComercialId)?.Nombre ?? "Plan eliminado" : "Sin plan")</div>
                    </div>
                }
            </div>
        </section></div>
        <div class="col-12 col-lg-6"><section class="card h-100">
            <div class="card-header"><h2 class="h5 mb-0">Restaurantes (@Model.Restaurantes.Count)</h2></div>
            <div class="card-body">
                <form asp-action="GuardarRestaurante" method="post" class="row g-2 mb-3">
                    <div class="col-5"><input class="form-control" name="nombre" maxlength="120" required placeholder="Nuevo restaurante" /></div>
                    <div class="col-5"><select name="cadenaId" class="form-select"><option value="">Independiente</option>
                        @foreach(var c in Model.Cadenas) { <option value="@c.Id">@c.Nombre</option> }
                    </select></div>
                    <div class="col-2"><button class="btn btn-primary">Crear</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm">
                    <thead><tr><th>Local</th><th>Cadena</th><th>Usuarios</th><th>Plan</th></tr></thead>
                    <tbody>
                    @foreach(var local in Model.Restaurantes) {
                        var propio = suscripciones.FirstOrDefault(s => s.RestauranteId == local.Id);
                        var heredado = suscripciones.FirstOrDefault(s => s.CadenaId == local.CadenaId && local.CadenaId.HasValue);
                        <tr>
                            <td><a asp-action="DetalleRestaurante" asp-route-id="@local.Id">@local.Nombre</a> @if(!local.Activo){<span class="badge text-bg-secondary">Inactivo</span>}</td>
                            <td>@local.Cadena</td>
                            <td>@usuarios.GetValueOrDefault(local.Id)</td>
                            <td>@(planes.FirstOrDefault(p=>p.Id==(propio??heredado)?.PlanComercialId)?.Nombre ?? "Sin plan")</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        </section></div>
        <div class="col-12"><section class="card">
            <div class="card-header"><h2 class="h5 mb-0">Planes y suscripciones</h2></div>
            <div class="card-body">
                <form asp-action="GuardarPlan" method="post" class="row g-2 mb-3">
                    <div class="col-md-5"><input name="nombre" class="form-control" required maxlength="120" placeholder="Nuevo plan (Plus, Cadena Pro...)" /></div>
                    <div class="col-md-4"><input name="maxRestaurantes" type="number" min="1" class="form-control" placeholder="Máximo locales (vacío = sin límite)" /></div>
                    <div class="col-md-3"><button class="btn btn-primary">Crear plan</button></div>
                </form>
                @foreach(var plan in planes) {
                    <form asp-action="GuardarPlan" method="post" class="row g-2 mb-2">
                        <input type="hidden" name="id" value="@plan.Id" />
                        <div class="col-4"><input name="nombre" value="@plan.Nombre" class="form-control form-control-sm" maxlength="120" required /></div>
                        <div class="col-3"><input name="maxRestaurantes" type="number" min="1" value="@plan.MaxRestaurantes" class="form-control form-control-sm" placeholder="Locales" /></div>
                        <div class="col-3"><select name="activo" class="form-select form-select-sm">
                            <option value="true" selected="@plan.Activo">Disponible</option><option value="false" selected="@(!plan.Activo)">Desactivado</option>
                        </select></div>
                        <div class="col-2"><button class="btn btn-sm btn-outline-primary">Guardar</button></div>
                    </form>
                }
                <hr/>
                <h3 class="h6">Asignar plan a cadena o restaurante</h3>
                <form asp-action="GuardarSuscripcion" method="post" class="row g-2">
                    <div class="col-lg-4"><select name="cadenaId" class="form-select"><option value="">Sin cadena (asignación a local)</option>
                        @foreach(var c in Model.Cadenas) { <option value="@c.Id">@c.Nombre</option> }
                    </select></div>
                    <div class="col-lg-3"><select name="restauranteId" class="form-select"><option value="">Sin restaurante (asignación a cadena)</option>
                        @foreach(var l in Model.Restaurantes) { <option value="@l.Id">@l.Nombre</option> }
                    </select></div>
                    <div class="col-lg-3"><select name="planId" class="form-select" required>
                        @foreach(var p in planes.Where(p=>p.Activo)) { <option value="@p.Id">@p.Nombre</option> }
                    </select></div>
                    <div class="col-lg-2"><button class="btn btn-primary w-100">Asignar</button></div>
                    <div class="col-12"><small class="text-muted">Selecciona exactamente una cadena o un restaurante. Si un local tiene plan propio, prevalece sobre el de su cadena.</small></div>
                </form>
            </div>
        </section></div>
        <div class="col-12"><section class="card">
            <div class="card-header"><h2 class="h5 mb-0">Catálogo de funcionalidades</h2></div>
            <div class="card-body">
                <form asp-action="CrearFuncionalidad" method="post" class="row g-2 mb-3">
                    <div class="col-md-4"><input name="clave" class="form-control" required placeholder="reportes.avanzados" maxlength="80" /></div>
                    <div class="col-md-5"><input name="nombre" class="form-control" required maxlength="120" placeholder="Nombre visible" /></div>
                    <div class="col-md-3"><button class="btn btn-primary">Crear capacidad</button></div>
                </form>
                <div class="table-responsive"><table class="table table-sm">
                    <thead><tr><th>Funcionalidad</th><th>Plan</th><th>Operación</th></tr></thead><tbody>
                    @foreach(var f in funciones) {
                        @foreach(var p in planes) {
                            <tr><td>@f.Nombre <code>@f.Clave</code></td><td>@p.Nombre</td><td>
                                <form asp-action="DefinirPlanFuncionalidad" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="planId" value="@p.Id"/><input type="hidden" name="funcionalidadId" value="@f.Id"/>
                                    <select name="habilitada" class="form-select form-select-sm">
                                        <option value="true" selected="@planFunciones.Contains($"{p.Id}:{f.Id}")">Habilitada</option>
                                        <option value="false" selected="@(!planFunciones.Contains($"{p.Id}:{f.Id}"))">Deshabilitada</option>
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary">Aplicar</button>
                                </form>
                            </td></tr>
                        }
                    }
                    </tbody>
                </table></div>
            </div>
        </section></div>
    </div>
</div>
