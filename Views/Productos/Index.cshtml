@model List<ProductoViewModel>

@{
    ViewData["Title"] = "Productos";
    var clp = new System.Globalization.CultureInfo("es-CL");
}

<div class="row mb-3">
    <div class="col">
        <h2>Productos</h2>
    </div>
    <div class="col text-end">
        <a asp-action="Crear" class="btn btn-primary">+ Nuevo Producto</a>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Foto</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Disponibilidad</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model.OrderBy(p => p.Nombre))
        {
            <tr>
                <td style="width: 76px;">
                    @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                    {
                        <img src="@producto.ImagenUrl"
                             alt="@producto.Nombre"
                             loading="lazy"
                             class="rounded border"
                             style="width: 56px; height: 56px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted"
                             style="width: 56px; height: 56px;"
                             aria-label="Sin foto">—</div>
                    }
                </td>
                <td>
                    <strong>@producto.Nombre</strong><br />
                    <small class="text-muted">@producto.Descripcion</small>
                </td>
                <td>@producto.Precio.ToString("C0", clp)</td>
                <td>
                    <span class="badge @(producto.Activo ? "bg-success" : "bg-danger")">
                        @(producto.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td>
                    <span class="badge @(producto.Disponible ? "bg-info" : "bg-secondary")">
                        @(producto.Disponible ? "Disponible" : "No disponible")
                    </span>
                </td>
                <td>
                    <a asp-action="Ingredientes" asp-route-productoId="@producto.Id" class="btn btn-sm btn-info" title="Asignar ingredientes">
                        <i class="bi bi-list-check"></i> Ingredientes
                    </a>
                    <a asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="Activar" asp-route-id="@producto.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm @(producto.Activo ? "btn-danger" : "btn-success")">
                            @(producto.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay productos.</div>
}
