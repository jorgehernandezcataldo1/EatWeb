@model List<ProductoViewModel>
@{
    ViewData["Title"] = "Carta";
    var clp = new System.Globalization.CultureInfo("es-CL");
    var categorias = Model
        .Where(p => !string.IsNullOrWhiteSpace(p.CategoriaNombre))
        .GroupBy(p => p.CategoriaNombre!)
        .OrderBy(g => g.Key)
        .Select(g => new { Nombre = g.Key, Cantidad = g.Count() })
        .ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="text-uppercase small fw-bold text-muted mb-1">Gestión de carta</div>
        <h1 class="admin-dashboard-title h2 mb-1">Carta</h1>
        <div class="admin-dashboard-subtitle">Productos, categorías e ingredientes en un flujo simple.</div>
    </div>
    <a asp-action="Crear" class="btn btn-comidita px-4">+ Nuevo producto</a>
</div>

<div class="admin-panel mb-3">
    <div class="admin-panel-body">
        <div class="d-flex flex-column flex-lg-row gap-2 align-items-lg-center">
            <input type="search" class="form-control flex-grow-1" id="buscarProducto"
                   placeholder="Buscar producto..." />
            <div class="d-flex gap-2 overflow-x-auto pb-1" id="filtrosCarta">
                <button class="btn btn-sm btn-comidita carta-filter active" type="button" data-categoria="todas">
                    Todos <span class="badge text-bg-light ms-1">@Model.Count</span>
                </button>
                @foreach (var categoria in categorias)
                {
                    <button class="btn btn-sm btn-outline-secondary carta-filter text-nowrap"
                            type="button" data-categoria="@categoria.Nombre.ToLowerInvariant()">
                        @categoria.Nombre <span class="badge text-bg-light ms-1">@categoria.Cantidad</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <section class="admin-panel">
        <div class="admin-panel-body text-center py-5">
            <div class="fs-2 mb-2">◫</div>
            <h2 class="h5 fw-bold">Tu carta está vacía</h2>
            <p class="text-muted">Crea tu primer producto y desde el mismo flujo podrás crear su categoría e ingredientes.</p>
            <a asp-action="Crear" class="btn btn-comidita">Crear primer producto</a>
        </div>
    </section>
}
else
{
    <div class="row g-3" id="productosCarta">
        @foreach (var producto in Model)
        {
            <div class="col-sm-6 col-xl-4 col-xxl-3 carta-producto"
                 data-nombre="@producto.Nombre.ToLowerInvariant()"
                 data-categoria="@(producto.CategoriaNombre?.ToLowerInvariant() ?? "")">
                <article class="carta-product-card">
                    <div class="carta-product-photo">
                        @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                        {
                            <img src="@producto.ImagenUrl" alt="@producto.Nombre" loading="lazy" />
                        }
                        else
                        {
                            <span>◫</span>
                        }
                        @if (!producto.Disponible)
                        {
                            <span class="carta-product-unavailable">No disponible</span>
                        }
                    </div>
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="min-w-0">
                                <h2 class="h6 fw-bold mb-1 text-truncate">@producto.Nombre</h2>
                                <div class="small text-muted">
                                    @(producto.CategoriaNombre ?? "Sin categoría") · @(producto.EstacionNombre ?? "Sin estación")
                                </div>
                            </div>
                            <strong class="text-nowrap">@producto.Precio.ToString("C0", clp)</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                        {
                            <p class="carta-product-description mt-2 mb-2">@producto.Descripcion</p>
                        }

                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <span class="badge @(producto.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(producto.Activo ? "Activo" : "Inactivo")
                            </span>
                            <span class="badge text-bg-light border">
                                @producto.CantidadIngredientes ingrediente@(producto.CantidadIngredientes == 1 ? "" : "s")
                            </span>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Editar" asp-route-id="@producto.Id"
                               class="btn btn-outline-secondary btn-sm flex-grow-1">Editar</a>
                            <form asp-action="Activar" asp-route-id="@producto.Id" method="post">
                                <button type="submit"
                                        class="btn btn-sm @(producto.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                    @(producto.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
    <div id="sinResultadosCarta" class="admin-panel d-none">
        <div class="admin-panel-body text-center text-muted py-5">No encontramos productos con ese filtro.</div>
    </div>
}

@section Scripts {
<script>
(() => {
    const input = document.getElementById('buscarProducto');
    const cards = Array.from(document.querySelectorAll('.carta-producto'));
    const buttons = Array.from(document.querySelectorAll('.carta-filter'));
    let categoria = 'todas';

    function filtrar() {
        const q = (input?.value || '').trim().toLowerCase();
        let visibles = 0;
        cards.forEach(card => {
            const coincideTexto = !q || (card.dataset.nombre || '').includes(q);
            const coincideCategoria = categoria === 'todas' || card.dataset.categoria === categoria;
            const mostrar = coincideTexto && coincideCategoria;
            card.classList.toggle('d-none', !mostrar);
            if (mostrar) visibles++;
        });
        document.getElementById('sinResultadosCarta')?.classList.toggle('d-none', visibles > 0);
    }

    buttons.forEach(btn => btn.addEventListener('click', () => {
        categoria = btn.dataset.categoria || 'todas';
        buttons.forEach(x => {
            const activo = x === btn;
            x.classList.toggle('btn-comidita', activo);
            x.classList.toggle('active', activo);
            x.classList.toggle('btn-outline-secondary', !activo);
        });
        filtrar();
    }));

    input?.addEventListener('input', filtrar);
})();
</script>
}
