@model ProductoViewModel

@{
    ViewData["Title"] = "Crear Producto";
}

<h2>Crear Nuevo Producto</h2>

<form asp-action="Crear" method="post" enctype="multipart/form-data" class="row g-3 col-md-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Precio" class="form-label">Precio</label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Precio" type="number" step="1" min="1" class="form-control" />
        </div>
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="col-12">
        <label asp-for="Imagen" class="form-label">Foto del producto</label>
        <input asp-for="Imagen"
               type="file"
               accept="image/jpeg,image/png,image/webp"
               class="form-control" />
        <div class="form-text">JPG, PNG o WebP. Máximo 5 MB.</div>
        <span asp-validation-for="Imagen" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CategoriaId" class="form-label">Categoría</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Seleccionar categoría...</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-check-inline">
            <input asp-for="Activo" type="checkbox" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Activo</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="Disponible" type="checkbox" class="form-check-input" />
            <label asp-for="Disponible" class="form-check-label">Disponible</label>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Crear</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
