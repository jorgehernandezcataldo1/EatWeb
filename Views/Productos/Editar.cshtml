@model ProductoViewModel
@{
    ViewData["Title"] = "Editar producto";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="text-uppercase small fw-bold text-muted mb-1">Gestión de carta</div>
        <h1 class="admin-dashboard-title h2 mb-1">Editar @Model.Nombre</h1>
        <div class="admin-dashboard-subtitle">Producto, categoría e ingredientes desde una sola pantalla.</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Volver a Carta</a>
</div>
<partial name="_Formulario" model="Model" />
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
