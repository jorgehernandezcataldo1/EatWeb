@model ProductoViewModel

@{
    ViewData["Title"] = "Editar Producto";
}

<h2>Editar Producto</h2>

<form asp-action="Editar" method="post" class="row g-3 col-md-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <input asp-for="Id" type="hidden" />

    <div class="col-md-6">
        <label for="nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label for="precio" class="form-label">Precio</label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
        </div>
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label for="descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="col-12">
        <label for="imagenUrl" class="form-label">URL Imagen</label>
        <input asp-for="ImagenUrl" class="form-control" />
    </div>

    <div class="col-md-6">
        <label for="categoriaId" class="form-label">Categoría</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Seleccionar categoría...</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-check-inline">
            <input asp-for="Activo" type="checkbox" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Activo</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="Disponible" type="checkbox" class="form-check-input" />
            <label asp-for="Disponible" class="form-check-label">Disponible</label>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
