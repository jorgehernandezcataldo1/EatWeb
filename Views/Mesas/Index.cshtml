@model List<MesaViewModel>

@{
    ViewData["Title"] = "Mesas";
    var clp = new CultureInfo("es-CL");
}

<h2 class="mb-3">Mis mesas</h2>

<div class="row g-3" id="tablero-mesas">
    @foreach (var mesa in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Mesa @mesa.Numero</h5>
                    <partial name="_EstadoMesaBadge" model="mesa.Estado" />
                    <p class="mb-0 mt-2 small text-muted">@mesa.Comensales comensal(es)</p>
                    <p class="mb-0"><strong>@mesa.TotalAcumulado.ToString("C0", clp)</strong></p>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No tienes mesas asignadas.</div>
}