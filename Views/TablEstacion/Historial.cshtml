@model List<EatWeb.Models.HistorialMensajeRapido>

@{
    ViewData["Title"] = "Historial de Mensajes";
    var estacion = (EatWeb.Models.Estacion)ViewData["Estacion"]!;
    var dias = (int)ViewData["Dias"]!;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>
                Historial - <span class="badge bg-primary">@estacion.Nombre</span>
            </h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="/tabl-estacion/index/@estacion.Id" class="btn btn-primary">
                ← Volver al Tablero
            </a>
        </div>
    </div>

    <!-- Filtro por días -->
    <div class="mb-3">
        <label class="form-label">Filtrar por período:</label>
        <div class="btn-group" role="group">
            <a href="/tabl-estacion/historial/@estacion.Id?dias=1" class="btn btn-outline-secondary @(dias == 1 ? "active" : "")">
                Último día
            </a>
            <a href="/tabl-estacion/historial/@estacion.Id?dias=7" class="btn btn-outline-secondary @(dias == 7 ? "active" : "")">
                Última semana
            </a>
            <a href="/tabl-estacion/historial/@estacion.Id?dias=30" class="btn btn-outline-secondary @(dias == 30 ? "active" : "")">
                Último mes
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No hay mensajes en el período seleccionado.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Hora</th>
                        <th>Mensaje</th>
                        <th>Enviado por</th>
                        <th>Estado</th>
                        <th>Leído en</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var historial in Model)
                    {
                        <tr class="@(historial.Leido ? "table-light" : "")">
                            <td>
                                <small class="text-muted">
                                    @historial.EnviadoEn.ToString("dd/MM/yyyy HH:mm:ss")
                                </small>
                            </td>
                            <td>
                                <strong>@historial.MensajeRapido.Texto</strong>
                            </td>
                            <td>
                                @historial.Garzon?.NombreCompleto ?? "Desconocido"
                            </td>
                            <td>
                                @if (historial.Leido)
                                {
                                    <span class="badge bg-success">Leído</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Sin leer</span>
                                }
                            </td>
                            <td>
                                @if (historial.LeidoEn.HasValue)
                                {
                                    <small class="text-muted">
                                        @historial.LeidoEn.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                    </small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Estadísticas -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Total</h5>
                        <h2 class="text-primary">@Model.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Leídos</h5>
                        <h2 class="text-success">@Model.Count(h => h.Leido)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Sin Leer</h5>
                        <h2 class="text-warning">@Model.Count(h => !h.Leido)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">% Leídos</h5>
                        <h2 class="text-info">
                            @{
                                var porcentaje = Model.Count > 0 ? Math.Round((double)Model.Count(h => h.Leido) / Model.Count * 100) : 0;
                            }
                            @porcentaje%
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
