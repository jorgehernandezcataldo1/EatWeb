@{
    ViewData["Title"] = "Tablero de Estación";
    var estacion = (EatWeb.Models.Estacion)ViewData["Estacion"]!;
    var estacionId = (int)ViewData["EstacionId"]!;
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1>
                <span class="badge bg-primary">@estacion.Nombre</span>
                Tablero de Mensajes Rápidos
            </h1>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        Mensajes Sin Leer
                        <span class="badge bg-danger" id="contador-mensajes">0</span>
                    </h5>
                </div>
                <div class="card-body" id="lista-mensajes">
                    <div class="text-center text-muted">
                        Cargando mensajes...
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-sm btn-secondary" id="btn-marcar-todos">
                        Marcar todos Como Leídos
                    </button>
                    <button class="btn btn-sm btn-info" id="btn-actualizar">
                        Actualizar
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Acciones Rápidas</h5>
                </div>
                <div class="card-body">
                    <a href="/tabl-estacion/historial/@estacionId" class="btn btn-sm btn-outline-primary w-100 mb-2">
                        Ver Historial
                    </a>
                    <a href="/admin/index" class="btn btn-sm btn-outline-secondary w-100">
                        Volver al Admin
                    </a>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Estadísticas</h5>
                </div>
                <div class="card-body" id="estadisticas">
                    <p class="text-muted small">Cargando...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .mensaje-item {
        border-left: 4px solid #ffc107;
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 4px;
        background-color: #fffbf0;
        transition: all 0.3s ease;
    }

    .mensaje-item.leido {
        border-left-color: #28a745;
        background-color: #f0f8f5;
        opacity: 0.7;
    }

    .mensaje-texto {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 8px;
        color: #333;
    }

    .mensaje-meta {
        font-size: 12px;
        color: #666;
    }

    .mensaje-time {
        color: #999;
        margin-left: 10px;
    }

    .btn-marcar-mensaje {
        float: right;
        margin-top: -8px;
    }
</style>

@section Scripts {
    <script>
        const estacionId = @estacionId;
        const urlMensajes = `/api/tabl-estacion/mensajes/${estacionId}`;
        const urlMarcarLeido = `/api/tabl-estacion/marcar-leido`;
        const urlMarcarTodos = `/api/tabl-estacion/marcar-todos-leido/${estacionId}`;

        function formatearFecha(dateString) {
            const date = new Date(dateString);
            const ahora = new Date();
            const diferencia = ahora - date;
            const minutos = Math.floor(diferencia / 60000);

            if (minutos < 1) return 'Hace unos segundos';
            if (minutos < 60) return `Hace ${minutos} min`;

            const horas = Math.floor(minutos / 60);
            if (horas < 24) return `Hace ${horas}h`;

            return date.toLocaleString('es-ES');
        }

        async function cargarMensajes() {
            try {
                const response = await fetch(urlMensajes);
                if (!response.ok) throw new Error('Error al cargar mensajes');

                const mensajes = await response.json();

                const contador = document.getElementById('contador-mensajes');
                contador.textContent = mensajes.length;

                const lista = document.getElementById('lista-mensajes');

                if (mensajes.length === 0) {
                    lista.innerHTML = '<div class="text-center text-muted py-4"><p>Sin mensajes pendientes</p></div>';
                    return;
                }

                lista.innerHTML = mensajes.map(msg => `
                    <div class="mensaje-item" data-id="${msg.id}">
                        <div class="mensaje-texto">${escapeHtml(msg.texto)}</div>
                        <div class="mensaje-meta">
                            <strong>Garzón:</strong> ${escapeHtml(msg.garzón)}
                            <span class="mensaje-time">${formatearFecha(msg.enviadoEn)}</span>
                        </div>
                        <button type="button" class="btn btn-xs btn-success btn-marcar-mensaje" onclick="marcarLeido(${msg.id})">
                            ✓ Leído
                        </button>
                        <div style="clear: both;"></div>
                    </div>
                `).join('');
            } catch (error) {
                console.error(error);
                document.getElementById('lista-mensajes').innerHTML = '<div class="alert alert-danger">Error al cargar mensajes</div>';
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function marcarLeido(historialId) {
            try {
                const response = await fetch(`${urlMarcarLeido}/${historialId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                    }
                });

                if (response.ok) {
                    document.querySelector(`[data-id="${historialId}"]`)?.remove();
                    cargarMensajes();
                }
            } catch (error) {
                console.error(error);
            }
        }

        async function marcarTodosLeido() {
            if (!confirm('¿Marcar todos los mensajes como leídos?')) return;

            try {
                const response = await fetch(urlMarcarTodos, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                    }
                });

                if (response.ok) {
                    cargarMensajes();
                    alert('Mensajes marcados como leídos');
                }
            } catch (error) {
                console.error(error);
            }
        }

        // Event listeners
        document.getElementById('btn-actualizar').addEventListener('click', cargarMensajes);
        document.getElementById('btn-marcar-todos').addEventListener('click', marcarTodosLeido);

        // Cargar mensajes al iniciar
        cargarMensajes();

        // Actualizar cada 3 segundos
        setInterval(cargarMensajes, 3000);
    </script>
}
