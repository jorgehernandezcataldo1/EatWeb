@model List<CategoriaViewModel>

@{
    ViewData["Title"] = "Categorías";
}

<div class="row mb-3">
    <div class="col">
        <h2>Categorías</h2>
    </div>
    <div class="col text-end">
        <a asp-action="Crear" class="btn btn-primary">+ Nueva Categoría</a>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Orden</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model.OrderBy(c => c.Orden))
        {
            <tr>
                <td>@categoria.Nombre</td>
                <td>@categoria.Orden</td>
                <td>
                    <span class="badge @(categoria.Activa ? "bg-success" : "bg-danger")">
                        @(categoria.Activa ? "Activa" : "Inactiva")
                    </span>
                </td>
                <td>
                    <a asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="Activar" asp-route-id="@categoria.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm @(categoria.Activa ? "btn-danger" : "btn-success")">
                            @(categoria.Activa ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay categorías.</div>
}
