@model EstacionViewModel

@{
    ViewData["Title"] = "Editar estación";
}

<h2>Editar estación</h2>

<form asp-action="Editar" method="post" class="row g-3 col-md-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>\n    <input asp-for="Id" type="hidden" />

    <div class="col-12">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Orden" class="form-label"></label>
        <input asp-for="Orden" type="number" class="form-control" />
        <span asp-validation-for="Orden" class="text-danger"></span>
    </div>

    <div class="col-12 form-check">
        <input asp-for="Activa" class="form-check-input" />
        <label asp-for="Activa" class="form-check-label"></label>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
