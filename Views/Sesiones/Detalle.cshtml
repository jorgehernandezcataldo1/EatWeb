@model CuentaViewModel
@{
    ViewData["Title"] = $"Historial Mesa {Model.MesaNumero}";
    var clp = new System.Globalization.CultureInfo("es-CL");
    var propinas = Model.Pagos.Sum(p => p.Propina);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Historial – Mesa @Model.MesaNumero</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver</a>
</div>

<div class="alert alert-secondary">
    <strong>Apertura:</strong> @Model.FechaApertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
</div>

@if (Model.SaldoPendiente > 0)
{
    <div class="alert alert-warning">
        Esta sesión histórica tiene @Model.SaldoPendiente.ToString("C0", clp) sin pago registrado.
        Puede corresponder a datos anteriores al flujo de pagos de Fase 2.
    </div>
}

<div class="row g-3">
    <div class="col-md-8">
        @foreach (var persona in Model.Personas)
        {
            <div class="card mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-start">
                    <strong>@persona.Nombre</strong>
                    <div class="text-end">
                        <strong>@persona.TotalConsumido.ToString("C0", clp)</strong>
                        @if (persona.TotalPagado > 0)
                        {
                            <div class="small text-success">Pagado @persona.TotalPagado.ToString("C0", clp)</div>
                        }
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (!persona.Items.Any())
                    {
                        <p class="text-muted p-3 mb-0">Sin consumos</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead>
                                <tr class="small text-muted">
                                    <th>Cant.</th>
                                    <th>Producto</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end">Pagado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in persona.Items)
                                {
                                    <tr>
                                        <td>@item.Cantidad×</td>
                                        <td>
                                            @item.Producto
                                            @if (item.Personalizaciones.Any())
                                            {
                                                <ul class="small text-muted mb-0">
                                                    @foreach (var p in item.Personalizaciones)
                                                    {
                                                        <li>@p</li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                        <td class="text-end">@item.Subtotal.ToString("C0", clp)</td>
                                        <td class="text-end">@item.MontoPagado.ToString("C0", clp)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }

        @if (Model.Pagos.Any())
        {
            <div class="card">
                <div class="card-header"><strong>Pagos registrados</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr class="small text-muted">
                                <th>Hora</th>
                                <th>Método</th>
                                <th>Persona</th>
                                <th class="text-end">Consumo</th>
                                <th class="text-end">Propina</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model.Pagos)
                            {
                                <tr>
                                    <td>@pago.Fecha.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                    <td>@pago.Metodo</td>
                                    <td>@(pago.ComensalNombre ?? "Mesa")</td>
                                    <td class="text-end">@pago.Monto.ToString("C0", clp)</td>
                                    <td class="text-end">@pago.Propina.ToString("C0", clp)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Cierre</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-6">Consumo</dt>
                    <dd class="col-6 text-end">@Model.Total.ToString("C0", clp)</dd>

                    <dt class="col-6 text-success">Pagado</dt>
                    <dd class="col-6 text-end text-success">@Model.TotalPagado.ToString("C0", clp)</dd>

                    <dt class="col-6">Propinas</dt>
                    <dd class="col-6 text-end">@propinas.ToString("C0", clp)</dd>

                    <dt class="col-6">Personas</dt>
                    <dd class="col-6 text-end">@Model.Personas.Count</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
