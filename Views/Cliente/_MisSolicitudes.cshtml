@model IReadOnlyList<SolicitudMesaResumenViewModel>

@if (!Model.Any())
{
    <div class="text-muted small py-2">No tienes solicitudes recientes.</div>
}
else
{
    <div class="d-grid gap-2">
        @foreach (var s in Model)
        {
            var titulo = s.Tipo switch
            {
                TipoSolicitudMesa.PedirCuenta => "Pedir la cuenta",
                TipoSolicitudMesa.LlamarGarzon => "Llamar al garzón",
                TipoSolicitudMesa.SolicitarAlgo => "Solicitud adicional",
                _ => s.Tipo
            };

            var estadoClase = s.Estado switch
            {
                EstadoSolicitudMesa.Pendiente => "status-warning",
                EstadoSolicitudMesa.Atendida => "status-success",
                _ => ""
            };

            <div class="border rounded-3 p-2 p-md-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold small">@titulo</div>
                        <div class="small text-muted">
                            @ZonaHorariaService.ALocal(s.FechaCreacion).ToString("HH:mm")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(s.Mensaje))
                        {
                            <div class="small mt-1">@s.Mensaje</div>
                        }
                    </div>
                    <span class="ops-status-pill @estadoClase">@s.Estado</span>
                </div>

                @if (s.Estado == EstadoSolicitudMesa.Pendiente)
                {
                    <form asp-action="CancelarSolicitud" method="post" class="mt-2">
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Cancelar</button>
                    </form>
                }
            </div>
        }
    </div>
}
