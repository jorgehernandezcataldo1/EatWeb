@model MiMesaViewModel
@{
    ViewData["Title"] = "Mi Mesa";
    var clp = new System.Globalization.CultureInfo("es-CL");
}

<h3>Mesa @Model.MesaNumero – @Model.ComensalNombre</h3>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100 bg-light">
            <div class="card-body">
                <h5>Tu consumo</h5>
                <p class="display-6 mb-3">@Model.TotalConsumido.ToString("C0", clp)</p>

                @if (Model.CuentaSolicitada)
                {
                    <div class="alert alert-warning mb-0">
                        La cuenta ya fue solicitada. Puedes seguir viendo el estado de la solicitud aquí.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <strong>¿Necesitas ayuda?</strong>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <form asp-action="CrearSolicitud" method="post">
                        <input type="hidden" name="tipo" value="@TipoSolicitudMesa.LlamarGarzon" />
                        <button type="submit" class="btn btn-outline-primary w-100">
                            🙋 Llamar al garzón
                        </button>
                    </form>

                    <form asp-action="CrearSolicitud" method="post">
                        <input type="hidden" name="tipo" value="@TipoSolicitudMesa.PedirCuenta" />
                        <button type="submit" class="btn btn-warning w-100" disabled="@Model.CuentaSolicitada">
                            💰 Pedir la cuenta
                        </button>
                    </form>

                    <form asp-action="CrearSolicitud" method="post" class="border rounded p-2">
                        <input type="hidden" name="tipo" value="@TipoSolicitudMesa.SolicitarAlgo" />
                        <label class="form-label small">Pedir algo adicional</label>
                        <div class="input-group">
                            <input type="text" name="mensaje" maxlength="200"
                                   class="form-control"
                                   placeholder="Ej: agua, servilletas, cubiertos..." required />
                            <button type="submit" class="btn btn-outline-primary">Enviar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Solicitudes al garzón</strong>
        <small class="text-muted">Actualización automática</small>
    </div>
    <div class="card-body" id="misSolicitudes">
        <partial name="_MisSolicitudes" model="Model.Solicitudes" />
    </div>
</div>

<h5 class="mt-4">Tus pedidos</h5>

@if (Model.Pedidos.Count == 0)
{
    <div class="alert alert-info">Aún no has hecho pedidos.</div>
    <a asp-action="Carta" class="btn btn-primary">Ir a la carta</a>
}
else
{
    foreach (var p in Model.Pedidos)
    {
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>Pedido #@p.Id</strong>
                    <partial name="_EstadoPedidoBadge" model="p.Estado" />
                </div>
                <small class="text-muted">@p.Fecha.ToLocalTime().ToString("HH:mm")</small>

                <ul class="mb-1 mt-2">
                    @foreach (var item in p.Items)
                    {
                        <li>@item</li>
                    }
                </ul>

                @if (p.Personalizaciones.Any())
                {
                    <ul class="small text-muted mb-1">
                        @foreach (var pers in p.Personalizaciones)
                        {
                            <li>@pers</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(p.Observacion))
                {
                    <p class="small fst-italic mb-1">💬 @p.Observacion</p>
                }

                <div class="text-end">
                    <strong>@p.Total.ToString("C0", clp)</strong>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        async function actualizarMisSolicitudes() {
            try {
                const response = await fetch('@Url.Action("MisSolicitudes", "Cliente")', {
                    cache: 'no-store'
                });

                if (!response.ok) return;
                document.getElementById('misSolicitudes').innerHTML = await response.text();
            } catch {
                // La siguiente iteración vuelve a intentarlo.
            }
        }

        setInterval(actualizarMisSolicitudes, 8000);
    </script>
}
