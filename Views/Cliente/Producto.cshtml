@model ProductoDetalleViewModel
@{
    ViewData["Title"] = Model.Nombre;
    var clp = new System.Globalization.CultureInfo("es-CL");
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8">
        <div class="card shadow-sm">
            @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl" class="card-img-top"
                     style="max-height: 300px; object-fit: cover;" alt="@Model.Nombre" />
            }
            <div class="card-body">
                <h4>@Model.Nombre</h4>
                @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                {
                    <p class="text-muted">@Model.Descripcion</p>
                }
                <h5 class="text-primary">@Model.Precio.ToString("C0", clp)</h5>

                @if (!Model.Disponible)
                {
                    <div class="alert alert-warning">Producto no disponible</div>
                }
                else
                {
                    <form asp-action="AgregarAlCarrito" method="post">
                        <input type="hidden" name="ProductoId" value="@Model.Id" />

                        @if (Model.Incluidos.Any())
                        {
                            <h6 class="mt-3">Quitar ingredientes</h6>
                            foreach (var ing in Model.Incluidos)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="IngredientesQuitar"
                                           value="@ing.IngredienteId"
                                           id="q-@ing.IngredienteId" />
                                    <label class="form-check-label" for="q-@ing.IngredienteId">
                                        Sin @ing.Nombre
                                    </label>
                                </div>
                            }
                        }

                        @if (Model.Extras.Any())
                        {
                            <h6 class="mt-3">Agregar ingredientes</h6>
                            foreach (var ing in Model.Extras)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="IngredientesAgregar"
                                           value="@ing.IngredienteId"
                                           id="a-@ing.IngredienteId" />
                                    <label class="form-check-label" for="a-@ing.IngredienteId">
                                        Agregar @ing.Nombre
                                        @if (ing.PrecioExtra > 0)
                                        {
                                            <span>(+@ing.PrecioExtra.ToString("C0", clp))</span>
                                        }
                                    </label>
                                </div>
                            }
                        }

                        <div class="mt-3">
                            <label class="form-label">Observación (opcional)</label>
                            <input type="text" name="Observacion" class="form-control"
                                   maxlength="200" placeholder="Ej: sin sal, bien cocido..." />
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Cantidad</label>
                            <input type="number" name="Cantidad" value="1" min="1" max="20"
                                   class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                            🛒 Agregar al carrito
                        </button>
                    </form>
                }
            </div>
        </div>

        <a asp-action="Carta" class="btn btn-link mt-2">← Volver a la carta</a>
    </div>
</div>