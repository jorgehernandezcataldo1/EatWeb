@{
    ViewData["Title"] = "Dashboard Restaurante";
    var restaurante = (Restaurante)ViewBag.Restaurante;
    dynamic stats = ViewBag.Stats;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@restaurante.Nombre</h2>
        <small class="text-muted">Panel de administración</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="row mb-4">
    <div class="col-6 col-md-3 mb-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Productos</h5>
                <p class="card-text display-4 mb-0">@stats.TotalProductos</p>
            </div>
            <a asp-controller="Productos" asp-action="Index"
               class="card-footer text-white text-decoration-none">
                Ver todos →
            </a>
        </div>
    </div>

    <div class="col-6 col-md-3 mb-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <h5 class="card-title">Mesas</h5>
                <p class="card-text display-4 mb-0">@stats.TotalMesas</p>
            </div>
            <a asp-controller="Mesas" asp-action="Administrar"
               class="card-footer text-white text-decoration-none">
                Administrar →
            </a>
        </div>
    </div>

    <div class="col-6 col-md-3 mb-3">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <h5 class="card-title">Pedidos Hoy</h5>
                <p class="card-text display-4 mb-0">@stats.TotalPedidosHoy</p>
            </div>
            <a asp-controller="Pedidos" asp-action="Index"
               class="card-footer text-white text-decoration-none">
                Ver todos →
            </a>
        </div>
    </div>

    <div class="col-6 col-md-3 mb-3">
        <div class="card text-white bg-danger h-100">
            <div class="card-body">
                <h5 class="card-title">Pendientes</h5>
                <p class="card-text display-4 mb-0">@stats.PedidosPendientes</p>
            </div>
            <a asp-controller="Pedidos" asp-action="Index"
               class="card-footer text-white text-decoration-none">
                Atender →
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Accesos Rápidos</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Categorias" asp-action="Index"
                       class="btn btn-outline-primary text-start">
                        📁 Gestionar Categorías
                    </a>
                    <a asp-controller="Ingredientes" asp-action="Index"
                       class="btn btn-outline-primary text-start">
                        🥕 Gestionar Ingredientes
                    </a>
                    <a asp-controller="Productos" asp-action="Index"
                       class="btn btn-outline-primary text-start">
                        🍔 Gestionar Productos
                    </a>
                    <a asp-controller="Mesas" asp-action="Administrar"
                       class="btn btn-outline-success text-start">
                        🪑 Gestionar Mesas
                    </a>
                    <a asp-controller="Garzones" asp-action="Index"
                       class="btn btn-outline-info text-start">
                        👨 Gestionar Garzones
                    </a>
                    <a asp-controller="Pedidos" asp-action="Index"
                       class="btn btn-outline-warning text-start">
                        📋 Ver Pedidos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Información del restaurante</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@restaurante.Nombre</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(restaurante.Activo ? "bg-success" : "bg-danger")">
                            @(restaurante.Activo ? "Activo" : "Inactivo")
                        </span>
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(restaurante.LogoUrl))
                    {
                        <dt class="col-sm-4">Logo</dt>
                        <dd class="col-sm-8">
                            <img src="@restaurante.LogoUrl" alt="Logo"
                                 style="max-height: 60px;" />
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>