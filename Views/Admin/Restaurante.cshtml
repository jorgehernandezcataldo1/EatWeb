@model AdminRestauranteDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Restaurante";
    var clp = new CultureInfo("es-CL");
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
    <div>
        <h2 class="mb-0">@Model.RestauranteNombre</h2>
        <div class="d-flex align-items-center gap-2 mt-1">
            <span class="badge @(Model.RestauranteActivo ? "bg-success" : "bg-danger")">
                @(Model.RestauranteActivo ? "Restaurante activo" : "Restaurante inactivo")
            </span>
            <span class="badge @(Model.ListoParaPiloto ? "bg-success" : "bg-warning text-dark")">
                @(Model.ListoParaPiloto ? "Listo para piloto" : "Configuración pendiente")
            </span>
        </div>
    </div>

    @if (User.IsInRole(Roles.AdminCadena))
    {
        <a asp-action="Index" class="btn btn-outline-secondary">← Restaurantes</a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card h-100 border-success">
            <div class="card-body">
                <div class="small text-muted">Ventas hoy</div>
                <div class="fs-3 fw-bold">@Model.VentasHoy.ToString("C0", clp)</div>
                @if (Model.PropinasHoy > 0)
                {
                    <div class="small text-success">+ @Model.PropinasHoy.ToString("C0", clp) propinas</div>
                }
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <div class="small text-muted">Mesas ocupadas</div>
                <div class="fs-3 fw-bold">@Model.MesasOcupadas / @Model.TotalMesas</div>
                <a asp-controller="Mesas" asp-action="Index" class="small">Ver operación →</a>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100 border-warning">
            <div class="card-body">
                <div class="small text-muted">Pedidos activos</div>
                <div class="fs-3 fw-bold">@Model.PedidosActivos</div>
                <div class="small text-muted">@Model.TotalPedidosHoy pedidos hoy</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100 @(Model.SolicitudesPendientes > 0 ? "border-danger" : "border-secondary")">
            <div class="card-body">
                <div class="small text-muted">Solicitudes pendientes</div>
                <div class="fs-3 fw-bold">@Model.SolicitudesPendientes</div>
                <a asp-controller="Pedidos" asp-action="Index" class="small">Abrir tablero →</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Preparación para piloto</strong>
                <span class="small text-muted">
                    @Model.Checklist.Count(x => x.Ok)/@Model.Checklist.Count listo
                </span>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var item in Model.Checklist)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                        <div>
                            <div class="fw-semibold">
                                <span class="me-1">@(item.Ok ? "✅" : "⚠️")</span>
                                @item.Titulo
                            </div>
                            <div class="small text-muted">@item.Descripcion</div>
                        </div>
                        <a asp-controller="@item.Controller" asp-action="@item.Action"
                           class="btn btn-sm @(item.Ok ? "btn-outline-secondary" : "btn-outline-warning")">
                            @(item.Ok ? "Revisar" : "Configurar")
                        </a>
                    </div>
                }
            </div>

            @if (Model.ListoParaPiloto)
            {
                <div class="card-footer bg-success-subtle">
                    <strong>Configuración base completa.</strong>
                    Ya puedes ejecutar una prueba completa desde un QR real.
                </div>
            }
            else
            {
                <div class="card-footer bg-warning-subtle">
                    Completa los puntos pendientes antes de probar con clientes reales.
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header"><strong>Catálogo</strong></div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Productos configurados</span>
                    <strong>@Model.TotalProductos</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Disponibles para pedir</span>
                    <strong>@Model.ProductosDisponibles</strong>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><strong>Accesos rápidos</strong></div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-warning text-start">
                    📋 Operación y solicitudes
                </a>
                <a asp-controller="Mesas" asp-action="Administrar" class="btn btn-outline-success text-start">
                    🪑 Mesas y QR
                </a>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary text-start">
                    🍔 Productos
                </a>
                <a asp-controller="Garzones" asp-action="Index" class="btn btn-outline-info text-start">
                    👨 Garzones
                </a>
                <a asp-controller="Sesiones" asp-action="Index" class="btn btn-outline-secondary text-start">
                    🧾 Historial y cierres
                </a>
            </div>
        </div>
    </div>
</div>
