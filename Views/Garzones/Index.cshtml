@model List<GarzonViewModel>

@{
    ViewData["Title"] = "Garzones";
}

<div class="row mb-3">
    <div class="col"><h2>Garzones</h2></div>
    <div class="col text-end">
        <a asp-action="Crear" class="btn btn-primary">+ Nuevo Garzón</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Mesas</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td>@g.NombreCompleto</td>
                    <td>@g.Email</td>
                    <td>@(g.Mesas.Any() ? string.Join(", ", g.Mesas.Select(n => $"Mesa {n}")) : "—")</td>
                    <td>
                        <span class="badge @(g.Activo ? "bg-success" : "bg-danger")">
                            @(g.Activo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@g.Id" class="btn btn-sm btn-warning">Editar</a>
                        <form asp-action="Activar" asp-route-id="@g.Id" method="post" class="d-inline">
                            @if (g.Activo)
                            {
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Se cerrará su sesión y se liberarán sus mesas. ¿Continuar?')">
                                    Desactivar
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-success">Activar</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay garzones.</div>
}