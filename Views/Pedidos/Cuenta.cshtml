@model DivisionCuentaViewModel
@{
    ViewData["Title"] = $"Cuenta - Mesa {Model.MesaNumero}";
    var clp = new System.Globalization.CultureInfo("es-CL");
    var partesIniciales = Math.Max(1, Model.CantidadPartes);
}

<div class="ops-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="ops-title h3 mb-0">Cuenta · Mesa @Model.MesaNumero</h1>
                @if (Model.CuentaSolicitada)
                {
                    <span class="ops-status-pill status-danger">Solicitada</span>
                }
            </div>
            <div class="ops-subtitle small mt-1">
                Abierta @ZonaHorariaService.ALocal(Model.FechaApertura).ToString("HH:mm") · @Model.Personas.Count persona(s)
            </div>
        </div>

        <a asp-action="Mesa" asp-route-id="@Model.SesionId" class="btn btn-outline-secondary align-self-start align-self-md-auto">
            ← Volver a la mesa
        </a>
    </div>

    @if (!Model.PuedeCobrar)
    {
        <div class="alert alert-warning border-0 shadow-sm">
            Aún hay pedidos pendientes, en preparación o listos. Puedes revisar la cuenta, pero el pago se habilitará cuando estén resueltos.
        </div>
    }

    <div class="row g-3">
        <section class="col-xl-7">
            <div class="card ops-table-card mb-3">
                <div class="card-body">
                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="small text-muted">Total</div>
                            <div class="fs-5 fw-bold">@Model.Total.ToString("C0", clp)</div>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted">Pagado</div>
                            <div class="fs-5 fw-bold text-success">@Model.TotalPagado.ToString("C0", clp)</div>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted">Pendiente</div>
                            <div class="fs-5 fw-bold text-danger">@Model.SaldoPendiente.ToString("C0", clp)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-3">
                @foreach (var persona in Model.Personas)
                {
                    <article class="card ops-table-card">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h2 class="h6 fw-bold mb-1">@persona.Nombre</h2>
                                    <div class="small text-muted">
                                        Ingresó @ZonaHorariaService.ALocal(persona.FechaIngreso).ToString("HH:mm")
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-semibold">@persona.TotalConsumido.ToString("C0", clp)</div>
                                    @if (persona.SaldoPendiente > 0)
                                    {
                                        <div class="small text-danger">Pendiente @persona.SaldoPendiente.ToString("C0", clp)</div>
                                    }
                                    else
                                    {
                                        <div class="small text-success">Pagado</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            @if (!persona.Items.Any())
                            {
                                <div class="p-3 text-muted small">Sin consumos.</div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var item in persona.Items)
                                    {
                                        <div class="list-group-item py-3">
                                            <div class="d-flex justify-content-between align-items-start gap-3">
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold">@item.Cantidad× @item.Producto</div>

                                                    @if (item.Personalizaciones.Any())
                                                    {
                                                        <div class="small text-muted mt-1">@string.Join(" · ", item.Personalizaciones)</div>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(item.Observacion))
                                                    {
                                                        <div class="small fst-italic text-secondary mt-1">“@item.Observacion”</div>
                                                    }

                                                    <div class="small text-muted mt-1">@item.EstadoPedido</div>
                                                </div>
                                                <div class="text-end">
                                                    <div class="fw-semibold">@item.Subtotal.ToString("C0", clp)</div>
                                                    @if (item.SaldoPendiente == 0)
                                                    {
                                                        <span class="badge text-bg-success">Pagado</span>
                                                    }
                                                    else if (item.MontoPagado > 0)
                                                    {
                                                        <div class="small text-success">Pagado @item.MontoPagado.ToString("C0", clp)</div>
                                                        <div class="small text-danger">Saldo @item.SaldoPendiente.ToString("C0", clp)</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (Model.Pagos.Any())
            {
                <div class="card ops-table-card mt-3">
                    <div class="card-header">
                        <h2 class="h6 fw-bold mb-0">Pagos registrados</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr class="small text-muted">
                                    <th>Hora</th>
                                    <th>Método</th>
                                    <th>Persona</th>
                                    <th class="text-end">Consumo</th>
                                    <th class="text-end">Propina</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pago in Model.Pagos)
                                {
                                    <tr>
                                        <td>@ZonaHorariaService.ALocal(pago.Fecha).ToString("HH:mm")</td>
                                        <td>@pago.Metodo</td>
                                        <td>@(pago.ComensalNombre ?? "Mesa")</td>
                                        <td class="text-end">@pago.Monto.ToString("C0", clp)</td>
                                        <td class="text-end">
                                            @if (pago.PropinaPorcentaje.HasValue)
                                            {
                                                <div>@pago.Propina.ToString("C0", clp)</div>
                                                <div class="small text-muted">@pago.PropinaPorcentaje.Value.ToString("0.##")%</div>
                                            }
                                            else
                                            {
                                                @pago.Propina.ToString("C0", clp)
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <aside class="col-xl-5">
            <div class="card ops-table-card ops-sticky-panel">
                <div class="card-header">
                    <h2 class="h5 fw-bold mb-1">¿Cómo van a pagar?</h2>
                    <div class="small text-muted">Elige división, persona o ítems y luego el método de pago.</div>
                </div>

                @if (Model.SaldoPendiente > 0)
                {
                    <form asp-action="CerrarConDivision" method="post" id="formPago">
                        <div class="card-body">
                            <input type="hidden" name="SesionId" value="@Model.SesionId" />
                            <input type="hidden" name="Modo" id="inputModo" value="Todo" />
                            <input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")" />

                            <div class="row g-2 mb-3" role="group" aria-label="Forma de dividir la cuenta">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="modoVisual" id="modoTodo"
                                           checked onchange="cambiarModo('Todo')" />
                                    <label class="btn btn-outline-secondary w-100 h-100" for="modoTodo">Todo</label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="modoVisual" id="modoIgual"
                                           onchange="cambiarModo('Igual')" />
                                    <label class="btn btn-outline-secondary w-100 h-100" for="modoIgual">Partes iguales</label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="modoVisual" id="modoConsumo"
                                           onchange="cambiarModo('PorConsumo')" />
                                    <label class="btn btn-outline-secondary w-100 h-100" for="modoConsumo">Por persona</label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="modoVisual" id="modoPersonalizado"
                                           onchange="cambiarModo('Personalizado')" />
                                    <label class="btn btn-outline-secondary w-100 h-100" for="modoPersonalizado">Por ítems</label>
                                </div>
                            </div>

                            <div id="panelTodo" class="payment-mode-panel mb-3">
                                <div class="rounded-3 bg-light border p-3">
                                    Se registrará el saldo completo:
                                    <strong>@Model.SaldoPendiente.ToString("C0", clp)</strong>.
                                </div>
                            </div>

                            <div id="panelIgual" class="payment-mode-panel mb-3 d-none">
                                <label for="cantidadPartes" class="form-label">Dividir entre</label>
                                <input type="number" name="CantidadPartes" id="cantidadPartes"
                                       class="form-control" value="@partesIniciales" min="1" max="20"
                                       oninput="actualizarParte()" />
                                <div class="mt-2 small">
                                    Se registrará una parte de aproximadamente
                                    <strong id="montoParte"></strong>.
                                </div>
                            </div>

                            <div id="panelConsumo" class="payment-mode-panel mb-3 d-none">
                                <label class="form-label">Persona que paga</label>
                                <select name="ComensalId" id="comensalPago" class="form-select" onchange="actualizarPropinaEstimada()">
                                    <option value="" data-saldo="0">Seleccionar...</option>
                                    @foreach (var p in Model.Personas.Where(p => p.SaldoPendiente > 0))
                                    {
                                        <option value="@p.ComensalId" data-saldo="@p.SaldoPendiente">
                                            @p.Nombre — @p.SaldoPendiente.ToString("C0", clp)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div id="panelPersonalizado" class="payment-mode-panel mb-3 d-none">
                                <label class="form-label">Ítems que se pagarán</label>
                                <div class="border rounded-3 p-2" style="max-height: 280px; overflow:auto;">
                                    @foreach (var item in Model.Items)
                                    {
                                        <div class="form-check py-1">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="DetallePedidoIds"
                                                   value="@item.DetallePedidoId"
                                                   data-saldo="@item.SaldoPendiente"
                                                   id="detalle-@item.DetallePedidoId"
                                                   onchange="actualizarPropinaEstimada()" />
                                            <label class="form-check-label small" for="detalle-@item.DetallePedidoId">
                                                <strong>@item.ComensalNombre:</strong>
                                                @item.Cantidad× @item.Producto · @item.SaldoPendiente.ToString("C0", clp)
                                            </label>
                                        </div>
                                    }
                                </div>
                                <button type="button" class="btn btn-sm btn-link px-0 mt-1" onclick="seleccionarTodo()">
                                    Seleccionar todos
                                </button>
                            </div>

                            <hr />

                            <label class="form-label fw-semibold">Método de pago</label>
                            <div class="row g-2 mb-3">
                                @foreach (var metodo in new[] { "Efectivo", "Tarjeta", "Transferencia" })
                                {
                                    var idMetodo = $"metodo-{metodo.ToLowerInvariant()}";
                                    <div class="col-4">
                                        <input class="btn-check" type="radio" name="Metodo" value="@metodo"
                                               id="@idMetodo" checked="@(metodo == "Efectivo")" />
                                        <label class="btn btn-outline-secondary w-100 small" for="@idMetodo">@metodo</label>
                                    </div>
                                }
                            </div>

                            <label class="form-label fw-semibold">Propina voluntaria</label>
                            <input type="hidden" name="Propina" value="0" />
                            <input type="hidden" name="PropinaPorcentaje" id="propinaPorcentaje" value="0" />

                            <div class="row g-2 mb-2" role="group" aria-label="Porcentaje de propina">
                                <div class="col-4">
                                    <button type="button" class="btn btn-outline-secondary w-100 propina-opcion active"
                                            data-porcentaje="0" onclick="seleccionarPropina(0, this)">0%</button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn btn-outline-secondary w-100 propina-opcion"
                                            data-porcentaje="10" onclick="seleccionarPropina(10, this)">10%</button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn btn-outline-secondary w-100 propina-opcion"
                                            data-porcentaje="15" onclick="seleccionarPropina(15, this)">15%</button>
                                </div>
                            </div>

                            <div class="input-group">
                                <span class="input-group-text">%</span>
                                <input type="number" id="propinaPersonalizada"
                                       min="0" max="100" step="0.01"
                                       class="form-control"
                                       placeholder="Otro porcentaje"
                                       oninput="usarPropinaPersonalizada()" />
                            </div>

                            <div class="form-text">
                                Se calcula en el servidor sobre el consumo incluido en este pago, no sobre propinas anteriores.
                            </div>
                            <div class="small mt-2">
                                Propina estimada: <strong id="propinaEstimada">@0.ToString("C0", clp)</strong>
                            </div>
                        </div>

                        <div class="card-footer bg-white">
                            @if (Model.PuedeCobrar)
                            {
                                <button type="submit" class="btn btn-comidita w-100"
                                        onclick="return confirm('¿Registrar este pago?');">
                                    Registrar pago
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-comidita w-100" disabled>
                                    Pago pendiente de pedidos
                                </button>
                            }
                        </div>
                    </form>
                }
                else
                {
                    <div class="card-body text-center">
                        <div class="display-6 text-success mb-2">✓</div>
                        <h3 class="h5">Cuenta pagada</h3>
                        <p class="text-muted small">No queda saldo pendiente.</p>

                        @if (Model.PuedeCobrar)
                        {
                            <form asp-action="CerrarMesa" asp-route-id="@Model.SesionId" method="post"
                                  onsubmit="return confirm('¿Cerrar la mesa?');">
                                <button type="submit" class="btn btn-comidita w-100">Cerrar mesa</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </aside>
    </div>
</div>

@section Scripts {
<script>
    const totalCuenta = @Model.Total;
    const saldoPendiente = @Model.SaldoPendiente;
    const clp = new Intl.NumberFormat('es-CL', {
        style: 'currency',
        currency: 'CLP',
        maximumFractionDigits: 0
    });

    function cambiarModo(modo) {
        document.getElementById('inputModo').value = modo;

        ['Todo', 'Igual', 'Consumo', 'Personalizado'].forEach(nombre => {
            const panel = document.getElementById('panel' + nombre);
            if (panel) panel.classList.add('d-none');
        });

        const id = modo === 'PorConsumo' ? 'panelConsumo' : 'panel' + modo;
        document.getElementById(id)?.classList.remove('d-none');

        if (modo === 'Igual') actualizarParte();
        actualizarPropinaEstimada();
    }

    function actualizarParte() {
        const input = document.getElementById('cantidadPartes');
        if (!input) return;
        const n = Math.max(1, parseInt(input.value) || 1);
        const parte = Math.min(Math.ceil(totalCuenta / n), saldoPendiente);
        const salida = document.getElementById('montoParte');
        if (salida) salida.textContent = clp.format(parte);
        actualizarPropinaEstimada();
    }

    function seleccionarTodo() {
        document.querySelectorAll('input[name="DetallePedidoIds"]').forEach(x => x.checked = true);
        actualizarPropinaEstimada();
    }

    function seleccionarPropina(porcentaje, boton) {
        document.getElementById('propinaPorcentaje').value = porcentaje;
        document.getElementById('propinaPersonalizada').value = '';

        document.querySelectorAll('.propina-opcion').forEach(x => x.classList.remove('active'));
        boton?.classList.add('active');

        actualizarPropinaEstimada();
    }

    function usarPropinaPersonalizada() {
        const input = document.getElementById('propinaPersonalizada');
        const valor = Math.min(100, Math.max(0, parseFloat(input?.value || '0') || 0));

        document.getElementById('propinaPorcentaje').value = valor;
        document.querySelectorAll('.propina-opcion').forEach(x => x.classList.remove('active'));
        actualizarPropinaEstimada();
    }

    function obtenerBasePago() {
        const modo = document.getElementById('inputModo')?.value || 'Todo';

        if (modo === 'Todo')
            return saldoPendiente;

        if (modo === 'Igual') {
            const n = Math.max(1, parseInt(document.getElementById('cantidadPartes')?.value || '1') || 1);
            return Math.min(Math.ceil(totalCuenta / n), saldoPendiente);
        }

        if (modo === 'PorConsumo') {
            const opcion = document.getElementById('comensalPago')?.selectedOptions?.[0];
            return Number(opcion?.dataset?.saldo || 0);
        }

        if (modo === 'Personalizado' || modo === 'Seleccion') {
            return Array.from(document.querySelectorAll('input[name="DetallePedidoIds"]:checked'))
                .reduce((suma, item) => suma + Number(item.dataset.saldo || 0), 0);
        }

        return 0;
    }

    function actualizarPropinaEstimada() {
        const porcentaje = Number(document.getElementById('propinaPorcentaje')?.value || 0);
        const base = obtenerBasePago();
        const monto = Math.round(base * porcentaje / 100);
        const salida = document.getElementById('propinaEstimada');

        if (salida) salida.textContent = clp.format(monto);
    }

    document.addEventListener('DOMContentLoaded', () => {
        actualizarParte();
        actualizarPropinaEstimada();
    });
</script>
}
