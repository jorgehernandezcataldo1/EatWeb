@model PedidosIndexViewModel
@{
    ViewData["Title"] = "Pedidos";
    var clp = new System.Globalization.CultureInfo("es-CL");
}

<div class="ops-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h1 class="ops-title h3 mb-1">Pedidos</h1>
            <div class="ops-subtitle small">Monitor informativo de las mesas en servicio.</div>
        </div>
        <a asp-controller="Mesas" asp-action="Index" class="btn btn-outline-secondary">← Mesas</a>
    </div>

    <div class="row g-3">
        <section class="col-xl-9">
            <div id="pedidosActivosPanel">
                @if (!Model.Mesas.Any())
                {
                    <div class="card ops-table-card">
                        <div class="card-body py-5 text-center text-muted">No hay pedidos activos.</div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var m in Model.Mesas)
                        {
                            var detalles = m.Pedidos.SelectMany(p => p.Detalles).ToList();
                            var pendientes = detalles.Count(d => d.Estado == EstadoDetallePedido.Pendiente);
                            var preparando = detalles.Count(d => d.Estado == EstadoDetallePedido.EnPreparacion);
                            var listos = detalles.Count(d => d.Estado == EstadoDetallePedido.Listo);
                            var total = m.Pedidos.Sum(p => p.Total);

                            <div class="col-md-6 col-xxl-4">
                                <a asp-action="Mesa" asp-route-id="@m.SesionId"
                                   class="card ops-table-card h-100 text-decoration-none text-reset shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between gap-2">
                                            <div>
                                                <h2 class="h5 fw-bold mb-1">Mesa @m.MesaNumero</h2>
                                                <div class="small text-muted">@m.Pedidos.Count pedido(s)</div>
                                            </div>
                                            @if (m.CuentaSolicitada)
                                            {
                                                <span class="ops-status-pill status-danger">Cuenta</span>
                                            }
                                        </div>

                                        <div class="row g-2 text-center mt-3">
                                            <div class="col">
                                                <div class="rounded border p-2">
                                                    <div class="small text-muted">Pend.</div>
                                                    <strong>@pendientes</strong>
                                                </div>
                                            </div>
                                            <div class="col">
                                                <div class="rounded border p-2">
                                                    <div class="small text-muted">Prep.</div>
                                                    <strong>@preparando</strong>
                                                </div>
                                            </div>
                                            <div class="col">
                                                <div class="rounded border p-2">
                                                    <div class="small text-muted">Listos</div>
                                                    <strong>@listos</strong>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="small text-muted">Total mesa</span>
                                            <strong>@total.ToString("C0", clp)</strong>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <aside class="col-xl-3" id="solicitudes">
            <div class="ops-notifications ops-sticky-panel">
                <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                    <h2 class="h6 mb-0 fw-bold">Notificaciones</h2>
                    <span class="badge rounded-pill text-bg-danger">@Model.SolicitudesPendientes.Count</span>
                </div>
                <div class="p-2 p-md-3 d-grid gap-2">
                    @if (!Model.SolicitudesPendientes.Any())
                    {
                        <div class="text-muted small text-center py-4">Sin solicitudes pendientes.</div>
                    }
                    else
                    {
                        @foreach (var s in Model.SolicitudesPendientes)
                        {
                            var minutos = Math.Max(0, (int)(DateTime.UtcNow - s.FechaCreacion).TotalMinutes);
                            var texto = s.Tipo switch
                            {
                                TipoSolicitudMesa.PedirCuenta => "Solicita la cuenta",
                                TipoSolicitudMesa.LlamarGarzon => "Llama al garzón",
                                _ => s.Mensaje ?? "Solicitud"
                            };

                            <a asp-action="Mesa" asp-route-id="@s.SesionId"
                               class="ops-notification-item text-decoration-none text-reset @(minutos >= 5 ? "is-urgent" : "")">
                                <div class="fw-semibold small">Mesa @s.MesaNumero</div>
                                <div class="ops-notification-type">@texto</div>
                                <div class="ops-notification-time">@s.ComensalNombre · hace @minutos min</div>
                            </a>
                        }
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
<script>
    async function actualizarPedidos() {
        try {
            const response = await fetch('@Url.Action("Index", "Pedidos")', { cache: 'no-store' });
            if (!response.ok) return;
            const html = await response.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const nuevo = doc.getElementById('pedidosActivosPanel');
            if (nuevo) document.getElementById('pedidosActivosPanel').innerHTML = nuevo.innerHTML;
        } catch {}
    }
    setInterval(actualizarPedidos, 15000);
</script>
}
