@model PedidosIndexViewModel
@{
    ViewData["Title"] = "Pedidos";
    var clp = new System.Globalization.CultureInfo("es-CL");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Pedidos activos</h2>
    <small class="text-muted">
        <span class="spinner-border spinner-border-sm me-1"></span>
        Se actualiza cada 15s
    </small>
</div>

@if (!Model.Mesas.Any())
{
    <div class="alert alert-info">No hay pedidos activos por ahora.</div>
}
else
{
    @foreach (var m in Model.Mesas)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center
                        @(m.CuentaSolicitada ? "bg-warning text-dark" : "bg-light")">
                <div>
                    <strong class="fs-5">Mesa @m.MesaNumero</strong>
                    <span class="ms-2 text-muted">@m.Pedidos.Count pedido(s)</span>
                </div>
                @if (m.CuentaSolicitada)
                {
                    <span class="badge bg-dark">💰 Cuenta solicitada</span>
                }
            </div>
            <div class="card-body">
                @foreach (var p in m.Pedidos)
                {
                    <div class="border-start border-4 border-info ps-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>@p.ComensalNombre</strong>
                                <small class="text-muted ms-2">
                                    Pedido #@p.Id –
                                    @p.FechaCreacion.ToLocalTime().ToString("HH:mm")
                                </small>
                            </div>
                            <partial name="_EstadoPedidoBadge" model="p.Estado" />
                        </div>

                        <ul class="list-unstyled mt-2 mb-2">
                            @foreach (var d in p.Detalles)
                            {
                                <li class="mb-2 border rounded p-2">
                                    <div class="d-flex justify-content-between">
                                        <span><strong>@d.Cantidad×</strong> @d.Producto</span>
                                        <span><span class="badge bg-secondary">@d.Estacion</span> <span class="badge bg-info text-dark">@d.Estado</span></span>
                                    </div>
                                    @if (d.Personalizaciones.Any())
                                    {
                                        <ul class="small text-muted mb-0">
                                            @foreach (var pers in d.Personalizaciones)
                                            {
                                                <li>@pers</li>
                                            }
                                        </ul>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(d.Observacion))
                                    {
                                        <div class="small fst-italic text-secondary">💬 "@d.Observacion"</div>
                                    }
                                    <div class="btn-group btn-group-sm mt-1">
                                        @if (d.Estado == "Pendiente")
                                        {
                                            <form asp-action="CambiarEstadoDetalle" method="post"><input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="nuevoEstado" value="EnPreparacion" /><button class="btn btn-outline-info">Preparar</button></form>
                                        }
                                        else if (d.Estado == "EnPreparacion")
                                        {
                                            <form asp-action="CambiarEstadoDetalle" method="post"><input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="nuevoEstado" value="Listo" /><button class="btn btn-outline-success">Listo</button></form>
                                        }
                                        else if (d.Estado == "Listo")
                                        {
                                            <form asp-action="CambiarEstadoDetalle" method="post"><input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="nuevoEstado" value="Entregado" /><button class="btn btn-outline-secondary">Entregar</button></form>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>

                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group btn-group-sm">
                                @if (p.Estado == "Pendiente")
                                {
                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="nuevoEstado" value="EnPreparacion" />
                                        <button class="btn btn-info">▶ A preparación</button>
                                    </form>
                                    <form asp-action="CambiarEstado" method="post" class="d-inline ms-1">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="nuevoEstado" value="Cancelado" />
                                        <button class="btn btn-outline-danger"
                                                onclick="return confirm('¿Cancelar este pedido?')">
                                            ✕ Cancelar
                                        </button>
                                    </form>
                                }
                                else if (p.Estado == "EnPreparacion")
                                {
                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="nuevoEstado" value="Listo" />
                                        <button class="btn btn-success">✓ Listo</button>
                                    </form>
                                }
                                else if (p.Estado == "Listo")
                                {
                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="nuevoEstado" value="Entregado" />
                                        <button class="btn btn-secondary">🍽 Entregado</button>
                                    </form>
                                }
                            </div>
                            <strong>@p.Total.ToString("C0", clp)</strong>
                        </div>
                    </div>
                }

                <div class="btn-group btn-group-sm mt-2 me-2">
                    <form asp-action="CambiarEstadoMesa" method="post"><input type="hidden" name="id" value="@m.SesionId" /><input type="hidden" name="nuevoEstado" value="EnPreparacion" /><button class="btn btn-outline-info">Mesa → preparación</button></form>
                    <form asp-action="CambiarEstadoMesa" method="post"><input type="hidden" name="id" value="@m.SesionId" /><input type="hidden" name="nuevoEstado" value="Listo" /><button class="btn btn-outline-success">Mesa → listo</button></form>
                    <form asp-action="CambiarEstadoMesa" method="post"><input type="hidden" name="id" value="@m.SesionId" /><input type="hidden" name="nuevoEstado" value="Entregado" /><button class="btn btn-outline-secondary">Mesa → entregado</button></form>
                </div>
                <a asp-action="Cuenta" asp-route-id="@m.SesionId"
                   class="btn btn-outline-primary btn-sm mt-2">
                    📄 Ver cuenta completa
                </a>
                <a asp-action="Dividir" asp-route-id="@m.SesionId"
                   class="btn btn-outline-info btn-sm mt-2 ms-2">
                    💰 Dividir
                </a>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        setTimeout(() => location.reload(), 15000);
    </script>
}