@model DivisionCuentaViewModel
@{
    ViewData["Title"] = $"Cobrar cuenta - Mesa {Model.MesaNumero}";
    var clp = new System.Globalization.CultureInfo("es-CL");
    var partesIniciales = Math.Max(1, Model.CantidadPartes);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Cobrar / dividir – Mesa @Model.MesaNumero</h2>
        <small class="text-muted">Registra uno o varios pagos hasta completar el saldo.</small>
    </div>
    <a asp-action="Cuenta" asp-route-id="@Model.SesionId"
       class="btn btn-outline-secondary btn-sm">← Cuenta completa</a>
</div>

@if (!Model.PuedeCobrar)
{
    <div class="alert alert-warning">
        No se puede cobrar todavía: hay pedidos pendientes, en preparación o listos.
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">Saldo de la mesa</h5></div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col">
                        <div class="small text-muted">Total</div>
                        <strong>@Model.Total.ToString("C0", clp)</strong>
                    </div>
                    <div class="col">
                        <div class="small text-muted">Pagado</div>
                        <strong class="text-success">@Model.TotalPagado.ToString("C0", clp)</strong>
                    </div>
                    <div class="col">
                        <div class="small text-muted">Pendiente</div>
                        <strong class="text-danger">@Model.SaldoPendiente.ToString("C0", clp)</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">Comensales</h5></div>
            <ul class="list-group list-group-flush">
                @foreach (var p in Model.Personas)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>@p.Nombre</strong>
                                <small class="text-muted ms-2">@ZonaHorariaService.ALocal(p.FechaIngreso).ToString("HH:mm")</small>
                            </div>
                            <div class="text-end">
                                <div>@p.TotalConsumido.ToString("C0", clp)</div>
                                @if (p.TotalPagado > 0)
                                {
                                    <div class="small text-success">Pagado @p.TotalPagado.ToString("C0", clp)</div>
                                }
                                @if (p.SaldoPendiente > 0)
                                {
                                    <div class="small text-danger">Pendiente @p.SaldoPendiente.ToString("C0", clp)</div>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>

        @if (Model.Pagos.Any())
        {
            <div class="card mb-3">
                <div class="card-header"><strong>Pagos registrados</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr class="small text-muted">
                                <th>Hora</th>
                                <th>Método</th>
                                <th>Persona</th>
                                <th class="text-end">Monto</th>
                                <th class="text-end">Propina</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model.Pagos)
                            {
                                <tr>
                                    <td>@ZonaHorariaService.ALocal(pago.Fecha).ToString("HH:mm")</td>
                                    <td>@pago.Metodo</td>
                                    <td>@(pago.ComensalNombre ?? "Mesa")</td>
                                    <td class="text-end">@pago.Monto.ToString("C0", clp)</td>
                                    <td class="text-end">@pago.Propina.ToString("C0", clp)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card sticky-top" style="top: 1rem;">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Registrar pago</h5>
            </div>

            <form asp-action="CerrarConDivision" method="post" id="formPago">
                <div class="card-body">
                    <input type="hidden" name="SesionId" value="@Model.SesionId" />
                    <input type="hidden" name="Modo" id="inputModo" value="Todo" />
                    <input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")" />

                    <div class="btn-group w-100 mb-3" role="group" aria-label="Modo de pago">
                        <input type="radio" class="btn-check" name="modoVisual" id="modoTodo"
                               checked onchange="cambiarModo('Todo')" />
                        <label class="btn btn-outline-primary" for="modoTodo">Todo</label>

                        <input type="radio" class="btn-check" name="modoVisual" id="modoIgual"
                               onchange="cambiarModo('Igual')" />
                        <label class="btn btn-outline-primary" for="modoIgual">Igual</label>

                        <input type="radio" class="btn-check" name="modoVisual" id="modoConsumo"
                               onchange="cambiarModo('PorConsumo')" />
                        <label class="btn btn-outline-primary" for="modoConsumo">Persona</label>

                        <input type="radio" class="btn-check" name="modoVisual" id="modoPersonalizado"
                               onchange="cambiarModo('Personalizado')" />
                        <label class="btn btn-outline-primary" for="modoPersonalizado">Ítems</label>
                    </div>

                    <div id="panelTodo" class="mb-3">
                        <div class="alert alert-light border mb-0">
                            Se cobrará todo el saldo pendiente:
                            <strong>@Model.SaldoPendiente.ToString("C0", clp)</strong>.
                        </div>
                    </div>

                    <div id="panelIgual" class="mb-3" style="display:none;">
                        <label class="form-label">Dividir el total entre</label>
                        <input type="number" name="CantidadPartes" id="cantidadPartes"
                               class="form-control" value="@partesIniciales" min="1" max="20"
                               oninput="actualizarParte()" />
                        <div class="form-text">
                            Este pago registra una parte. Puedes repetir el proceso para las demás.
                        </div>
                        <div class="mt-2">
                            Una parte: <strong id="montoParte"></strong>
                        </div>
                    </div>

                    <div id="panelConsumo" class="mb-3" style="display:none;">
                        <label class="form-label">Comensal</label>
                        <select name="ComensalId" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var p in Model.Personas.Where(p => p.SaldoPendiente > 0))
                            {
                                <option value="@p.ComensalId">
                                    @p.Nombre — @p.SaldoPendiente.ToString("C0", clp)
                                </option>
                            }
                        </select>
                        <div class="form-text">Se cobrará todo el saldo pendiente de esa persona.</div>
                    </div>

                    <div id="panelPersonalizado" class="mb-3" style="display:none;">
                        <label class="form-label">Consumos pendientes</label>
                        <div class="border rounded p-2" style="max-height: 260px; overflow:auto;">
                            @foreach (var item in Model.Items)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox"
                                           name="DetallePedidoIds" value="@item.DetallePedidoId"
                                           id="detalle-@item.DetallePedidoId" />
                                    <label class="form-check-label small" for="detalle-@item.DetallePedidoId">
                                        <strong>@item.ComensalNombre:</strong>
                                        @item.Cantidad× @item.Producto —
                                        @item.SaldoPendiente.ToString("C0", clp)
                                    </label>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                onclick="seleccionarTodo()">
                            Seleccionar todos
                        </button>
                    </div>

                    <hr />

                    <label class="form-label small">Método de pago</label>
                    <select name="Metodo" class="form-select form-select-sm mb-3">
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta</option>
                        <option value="Transferencia">Transferencia</option>
                    </select>

                    <label class="form-label small">Propina</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">$</span>
                        <input type="number" name="Propina" min="0" step="1"
                               class="form-control" value="0" />
                    </div>
                    <div class="form-text">La propina se registra aparte y no reduce el saldo de consumo.</div>
                </div>

                <div class="card-footer">
                    @if (Model.PuedeCobrar && Model.SaldoPendiente > 0)
                    {
                        <button type="submit" class="btn btn-success w-100"
                                onclick="return confirm('¿Registrar este pago?');">
                            💰 Registrar pago
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success w-100" disabled>
                            💰 Registrar pago
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const totalCuenta = @Model.Total;
        const saldoPendiente = @Model.SaldoPendiente;
        const clp = new Intl.NumberFormat('es-CL', {
            style: 'currency',
            currency: 'CLP',
            maximumFractionDigits: 0
        });

        function cambiarModo(modo) {
            document.getElementById('inputModo').value = modo;
            document.getElementById('panelTodo').style.display = modo === 'Todo' ? 'block' : 'none';
            document.getElementById('panelIgual').style.display = modo === 'Igual' ? 'block' : 'none';
            document.getElementById('panelConsumo').style.display = modo === 'PorConsumo' ? 'block' : 'none';
            document.getElementById('panelPersonalizado').style.display = modo === 'Personalizado' ? 'block' : 'none';

            if (modo === 'Igual') actualizarParte();
        }

        function actualizarParte() {
            const n = Math.max(1, parseInt(document.getElementById('cantidadPartes').value) || 1);
            const parte = Math.min(Math.ceil(totalCuenta / n), saldoPendiente);
            document.getElementById('montoParte').textContent = clp.format(parte);
        }

        function seleccionarTodo() {
            document.querySelectorAll('input[name="DetallePedidoIds"]').forEach(x => x.checked = true);
        }

        document.addEventListener('DOMContentLoaded', actualizarParte);
    </script>
}
