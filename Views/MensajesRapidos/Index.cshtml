@model List<EatWeb.Models.MensajeRapido>

@{
    ViewData["Title"] = "Mensajes Rápidos";
    var estaciones = (List<EatWeb.Models.Estacion>)ViewData["Estaciones"]!;
    var estacionSeleccionada = (int?)ViewData["EstacionSeleccionada"];
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="/mensajes-rapidos/crear" class="btn btn-primary">+ Nuevo Mensaje</a>
        </div>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtro por Estación -->
    <div class="mb-3">
        <label class="form-label">Filtrar por Estación:</label>
        <div class="btn-group" role="group">
            <a href="/mensajes-rapidos" class="btn btn-outline-secondary @(estacionSeleccionada == null ? "active" : "")">
                Todas
            </a>
            @foreach (var est in estaciones)
            {
                <a href="/mensajes-rapidos?estacionId=@est.Id" 
                   class="btn btn-outline-secondary @(estacionSeleccionada == est.Id ? "active" : "")">
                    @est.Nombre
                </a>
            }
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No hay mensajes rápidos configurados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Orden</th>
                        <th>Estación</th>
                        <th>Texto</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model.OrderBy(m => m.EstacionId).ThenBy(m => m.Orden))
                    {
                        <tr>
                            <td><span class="badge bg-info">@msg.Orden</span></td>
                            <td>
                                <strong>@msg.Estacion.Nombre</strong>
                            </td>
                            <td>@msg.Texto</td>
                            <td>
                                @if (msg.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>
                                <a href="/mensajes-rapidos/editar/@msg.Id" class="btn btn-sm btn-warning">Editar</a>
                                <form method="post" action="/mensajes-rapidos/eliminar/@msg.Id" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" 
                                            onclick="return confirm('¿Está seguro de que desea eliminar este mensaje?');">
                                        Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
